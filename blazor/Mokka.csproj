<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mokka</RootNamespace>
    <!-- Prices are formatted as nl-BE; load all ICU data so that works in every browser locale. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.21" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Tailwind v4 builds Styles/app.css into wwwroot/app.css.
    Runs before every build; needs Node.js and `npm install` once in this folder.
  -->
  <Target Name="BuildTailwind" BeforeTargets="Build" Condition="Exists('node_modules')">
    <Exec Command="npm run css:build" />
  </Target>

</Project>
