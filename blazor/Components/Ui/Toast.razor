@inherits StateComponent

@* Figma: "Overlay / Toegevoegd" and "Overlay / Wachtwoord gewijzigd" (Sonner, success colours).
   Stays 5 seconds, closes on tap. *@
<div class="pointer-events-none fixed inset-x-0 top-14 z-30 mx-auto w-full max-w-[390px] px-4" role="status" aria-live="polite">
    @if (State.Toast is { } toast)
    {
        <button type="button"
                class="toast-in pointer-events-auto flex w-full items-center gap-3 rounded-lg border border-success-border bg-success-subtle px-4 py-3.5 text-left text-success-text shadow-[0_8px_24px_rgb(31_82_41/0.14)]"
                @onclick="State.HideToast">
            <Icon Name="circle-check" Size="24" Class="text-success" />
            <span class="flex min-w-0 flex-1 flex-col gap-1 text-small">
                <span class="font-semibold">@toast.Title</span>
                <span class="font-normal">@toast.Text</span>
            </span>
            <span class="sr-only">Sluiten</span>
        </button>
    }
</div>
