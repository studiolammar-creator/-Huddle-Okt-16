@page "/nieuw-wachtwoord"
@inherits StateComponent

@* Mokka / Nieuw wachtwoord 3045:608 — saving shows the "Wachtwoord gewijzigd" toast on the login screen. *@

<PageTitle>Nieuw wachtwoord · Mokka</PageTitle>

<AuthShell BackHref="login" BackLabel="Terug naar inloggen">
    <span class="flex size-14 items-center justify-center rounded-full bg-secondary text-primary" aria-hidden="true">
        <Icon Name="key-round" Size="24" />
    </span>
    <div class="flex flex-col gap-2">
        <h1 class="text-display text-foreground">Kies een nieuw wachtwoord.</h1>
        <p class="text-body text-muted-foreground">Voor je account @State.Email. Daarna log je meteen in met je nieuwe wachtwoord.</p>
    </div>

    <form class="contents" @onsubmit="Save" novalidate>
        <TextField Id="nieuw" Label="Nieuw wachtwoord" Type="password" AutoComplete="new-password" Placeholder="Je wachtwoord"
                   Help="Minstens 8 tekens, met een cijfer." @bind-Value="_password" Error="@_passwordError" />
        <TextField Id="herhaal" Label="Herhaal je wachtwoord" Type="password" AutoComplete="new-password" Placeholder="Typ het nog een keer"
                   @bind-Value="_repeat" Error="@_repeatError" />
        <button type="submit" class="btn btn-primary w-full">Wachtwoord opslaan</button>
    </form>
</AuthShell>

@code {
    private string _password = "";
    private string _repeat = "";
    private string? _passwordError;
    private string? _repeatError;

    private void Save()
    {
        _passwordError = Passwords.IsStrong(_password) ? null : "Gebruik minstens 8 tekens, met een cijfer.";
        _repeatError = _repeat == _password ? null : "De twee wachtwoorden zijn niet gelijk.";
        if (_passwordError is not null || _repeatError is not null) return;

        State.ShowToast("Wachtwoord gewijzigd", "Log in met je nieuwe wachtwoord.");
        Nav.NavigateTo("login");
    }
}
