@page "/"
@inherits StateComponent

@*
    Mokka / Home (gast) 3040:265 and Mokka / Home (ingelogd) 3032:121
    Same page: only the top right differs (Inloggen button or avatar).
*@

<PageTitle>Mokka</PageTitle>

<main class="flex flex-col gap-14 pt-14 pb-32">

    @* Hero *@
    <section class="flex flex-col items-end gap-6" aria-labelledby="hero-titel">
        <div class="flex w-full items-center justify-between px-4">
            <span class="font-display text-[24px] leading-8 font-semibold text-foreground [font-variation-settings:'SOFT'_0,'WONK'_1]">Mokka</span>
            <AccountButton />
        </div>
        <div class="flex w-full flex-col items-start gap-4 px-4">
            <h1 id="hero-titel" class="text-hero text-foreground">Koffie die al op je wacht.</h1>
            <p class="text-body text-muted-foreground">Bestel in de app en haal je koffie vers gezet af aan de toog op de Groenplaats.</p>
            <a href="menu" class="btn btn-primary">
                Bekijk het menu
                <Icon Name="arrow-right" />
            </a>
        </div>
        <img src="img/hero.jpg" alt="Barista schenkt melk in een cappuccino" width="374" height="300"
             class="h-75 w-[calc(100%-16px)] rounded-l-lg object-cover" />
    </section>

    @* Zo werkt het: three verbs, stepped *@
    <section class="flex flex-col gap-6 px-4" aria-labelledby="werkwijze-titel">
        <h2 id="werkwijze-titel" class="text-title text-foreground">Zo werkt het</h2>
        <ol class="flex flex-col gap-6">
            <li class="flex flex-col gap-1">
                <span class="text-display text-foreground">Kies.</span>
                <span class="text-body text-muted-foreground">Blader door het menu en kies je maat en melk.</span>
            </li>
            <li class="flex flex-col gap-1 pl-14">
                <span class="text-display text-foreground">Bestel.</span>
                <span class="text-body text-muted-foreground">Betaal in de app, je bestelling gaat meteen naar de bar.</span>
            </li>
            <li class="flex flex-col gap-1 pl-28">
                <span class="text-display text-primary">Haal af.</span>
                <span class="text-body text-muted-foreground">Je krijgt een seintje zodra je kop klaarstaat.</span>
            </li>
        </ol>
    </section>

    @* Nieuw aan de toog: checkerboard bento *@
    <section class="flex flex-col gap-4 px-4" aria-labelledby="nieuw-titel">
        <h2 id="nieuw-titel" class="text-title text-foreground">Nieuw aan de toog</h2>
        <div class="grid grid-cols-2 gap-3">
            <div class="flex flex-col gap-3">
                <a href="product/cold-brew" class="block h-55 overflow-hidden rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                    <img src="img/cold-brew.jpg" alt="Cold brew" class="size-full object-cover" />
                </a>
                <a href="product/chai-latte" class="flex h-37 flex-col justify-between rounded-lg bg-secondary p-4 text-secondary-foreground transition-colors hover:bg-secondary/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                    <span class="flex flex-col gap-1">
                        <span class="text-title">Chai latte</span>
                        <span class="text-caption">Zwarte thee met kaneel en kardemom.</span>
                    </span>
                    <span class="text-small">@Catalog.Euro(Catalog.Get("chai-latte").Price)</span>
                </a>
            </div>
            <div class="flex flex-col gap-3">
                <a href="product/cold-brew" class="flex h-37 flex-col justify-between rounded-lg bg-accent p-4 text-accent-foreground transition-colors hover:bg-accent/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                    <span class="flex flex-col gap-1">
                        <span class="text-caption font-medium">Nieuw</span>
                        <span class="text-title">Cold brew</span>
                        <span class="text-caption">Koud getrokken, zacht en fris met ijs.</span>
                    </span>
                    <span class="text-small">@Catalog.Euro(Catalog.Get("cold-brew").Price)</span>
                </a>
                <a href="product/chai-latte" class="block h-55 overflow-hidden rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
                    <img src="img/chai-latte.jpg" alt="Chai latte" class="size-full object-cover" />
                </a>
            </div>
        </div>
    </section>

    @* Over Mokka *@
    <section class="flex flex-col gap-6" aria-labelledby="verhaal-titel">
        <img src="img/zaak.jpg" alt="Interieur van Mokka Groenplaats" width="390" height="248" class="h-62 w-full object-cover" loading="lazy" />
        <div class="flex flex-col gap-3 px-4">
            <h2 id="verhaal-titel" class="text-display text-foreground">Klein, warm en vlak bij de Groenplaats.</h2>
            <p class="text-body text-muted-foreground">We branden in kleine batches en zetten elke kop pas wanneer je bestelling binnenkomt. Geen wachtrij, wel tijd voor een praatje aan de toog.</p>
        </div>
    </section>

    @* Langskomen *@
    <section class="flex flex-col gap-4 px-4" aria-labelledby="langskomen-titel">
        <h2 id="langskomen-titel" class="text-title text-foreground">Langskomen</h2>
        <div class="card flex flex-col gap-4 p-4">
            <div class="flex items-start gap-3">
                <Icon Name="map-pinned" Size="20" Class="text-primary" />
                <div class="flex flex-col gap-0.5">
                    <p class="text-small text-card-foreground">Groenplaats 12, 2000 Antwerpen</p>
                    <p class="text-caption text-muted-foreground">Afhalen aan de toog, rechts van de ingang</p>
                </div>
            </div>
            <div class="divider"></div>
            <div class="flex items-start gap-3">
                <Icon Name="store" Size="20" Class="text-primary" />
                <div class="flex flex-col gap-0.5">
                    <p class="text-small text-card-foreground">Ma tot vr 7:30 tot 18:00</p>
                    <p class="text-caption text-muted-foreground">Za en zo 8:30 tot 17:00</p>
                </div>
            </div>
            <a href="https://www.google.com/maps/search/?api=1&query=Groenplaats+12+2000+Antwerpen" target="_blank" rel="noopener"
               class="btn btn-outline w-full">Plan je route</a>
        </div>
    </section>

    @* Afsluiter *@
    <section class="px-4">
        <div class="flex flex-col gap-4 rounded-lg bg-primary p-6 text-primary-foreground">
            <h2 class="text-display">Zin in iets warms?</h2>
            <p class="text-body">Je kop staat klaar nog voor je binnenstapt.</p>
            <a href="menu" class="btn btn-secondary w-full">
                Bekijk het menu
                <Icon Name="arrow-right" />
            </a>
        </div>
    </section>
</main>

<Tabbalk Active="home" />
